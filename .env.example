# Neon Postgres (otomatis terisi saat Neon dihubungkan lewat Vercel Marketplace)
DATABASE_URL=

# Vercel Blob (otomatis terisi saat Blob store dihubungkan ke project)
BLOB_READ_WRITE_TOKEN=

# Opsional: URL publik situs, dipakai untuk link & QR. Default: host dari request.
NEXT_PUBLIC_SITE_URL=

# Opsional: batas tamu per acara (default 300)
MAX_GUESTS_LIMIT=

# Pengembangan lokal tanpa Neon/Blob: isi LOCAL_DEV=1
# Data disimpan di folder .local-data (pglite + file lokal).
LOCAL_DEV=
