# Neon Postgres (otomatis terisi saat Neon dihubungkan lewat Vercel Marketplace)
DATABASE_URL=

# Vercel Blob (otomatis terisi saat Blob store dihubungkan ke project)
BLOB_READ_WRITE_TOKEN=

# Opsional: URL publik situs, dipakai untuk link & QR. Default: host dari request.
NEXT_PUBLIC_SITE_URL=

# Opsional: batas tamu per acara (default 300)
MAX_GUESTS_LIMIT=

# Pengembangan lokal tanpa Neon/Blob: isi LOCAL_DEV=1
# Data disimpan di folder .local-data (pglite + file lokal).
LOCAL_DEV=

# Midtrans (QRIS + GoPay) — paywall aktif hanya jika kedua key diisi
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
# "true" untuk transaksi asli; selain itu memakai Sandbox
MIDTRANS_IS_PRODUCTION=false
# Harga dalam Rupiah (minimal 1000)
# Harga paket acara (host membuka download untuk semua tamu); paket "coba" selalu gratis
EVENT_PACKAGE_PRICES=intim:99000,pesta:249000,gala:499000
PRICE_UNLOCK_PERSON=15000
# Jumlah foto yang boleh di-download gratis per orang per album (0 = tidak ada)
FREE_DOWNLOADS_PER_PERSON=3

# --- Guardrails & ROI dashboard ---
# Private KPI / go-no-go page at /ops?key=<OPS_KEY>. Leave empty to disable the page.
OPS_KEY=
# Salt for hashing client addresses in the rate limiter (falls back to CRON_SECRET).
RATE_SALT=
# Optional overrides for the ROI assumptions (see lib/ops.ts for defaults):
# OPS_USD_IDR=16500
# OPS_MDR_PCT=1.5
# OPS_FIXED_IDR_MONTH=400000
# OPS_STORAGE_USD_GB=0.023
# OPS_TRANSFER_USD_GB=0.1
# OPS_GO_CONV= / OPS_KILL_CONV= / OPS_MIN_SAMPLE=50
